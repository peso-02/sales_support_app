<div class="mt-4">
  <h1>得意先一覧</h1>

  <div class="d-flex justify-content-between align-items-center my-3">
    <div>
      <%= link_to "新規登録", new_customer_path, class: "btn btn-primary" %>
      <%= link_to "CSV出力", customers_path(format: :csv), class: "btn btn-success" %>
    </div>
    
    <div>
      <%= form_with url: import_customers_path, multipart: true, class: "d-flex" do |f| %>
        <%= f.file_field :file, accept: ".csv", class: "form-control me-2" %>
        <%= f.submit "CSVインポート", class: "btn btn-info" %>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>得意先コード</th>
          <th>得意先名</th>
          <th>業態</th>
          <th>支払条件</th>
          <th>発注方法</th>
          <th>ケース割れ出荷</th>
          <th>ケース割れ送料</th>
          <th>納品書</th>
        </tr>
      </thead>
      <tbody>
        <% @customers.each do |customer| %>
          <tr>
            <td><%= customer.customer_code %></td>
            <td><%= link_to customer.customer_name, customer, class: "text-decoration-none" %></td>
            <td><%= customer.business_type %></td>
            <td><%= customer.payment_terms_display %></td>
            <td><%= customer.order_method ? I18n.t("enums.customer.order_method.#{customer.order_method}") : "-" %></td>
            <td><%= customer.case_break_shipping_allowed ? "可" : "否" %></td>
            <td><%= customer.case_break_shipping_allowed ? "#{customer.case_break_shipping_fee}円" : "-" %></td>
            <td><%= customer.delivery_note_type ? I18n.t("enums.customer.delivery_note_type.#{customer.delivery_note_type}") : "-" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>