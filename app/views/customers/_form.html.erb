<div class="mt-4">
  <%= form_with(model: customer) do |form| %>
    <% if customer.errors.any? %>
      <div class="alert alert-danger">
        <h5><%= pluralize(customer.errors.count, "個") %>のエラーがあります</h5>
        <ul class="mb-0">
          <% customer.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="table-responsive">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <th class="table-light align-middle" style="width: 200px;">得意先コード</th>
            <td><%= form.text_field :customer_code, class: "form-control" %></td>
          </tr>
          <tr>
            <th class="table-light align-middle">得意先名</th>
            <td><%= form.text_field :customer_name, class: "form-control" %></td>
          </tr>
          <tr>
            <th class="table-light align-middle">業態</th>
            <td><%= form.text_field :business_type, class: "form-control" %></td>
          </tr>
          <tr>
            <th class="table-light align-middle">締日</th>
            <td>
              <%= form.select :closing_day, [
                ['5日', 5],
                ['10日', 10],
                ['15日', 15],
                ['20日', 20],
                ['25日', 25],
                ['月末', 99]
              ], { include_blank: "選択してください" }, { class: "form-select" } %>
            </td>
          </tr>
          <tr>
            <th class="table-light align-middle">支払</th>
            <td>
              <div class="input-group">
                <%= form.number_field :payment_terms, min: 0, placeholder: "0〜12など", class: "form-control" %>
                <span class="input-group-text">ヶ月後</span>
              </div>
            </td>
          </tr>
          <tr>
            <th class="table-light align-middle">支払日</th>
            <td>
              <%= form.select :payment_day, [
                ['5日', 5],
                ['10日', 10],
                ['15日', 15],
                ['20日', 20],
                ['25日', 25],
                ['月末', 99]
              ], { include_blank: "選択してください" }, { class: "form-select" } %>
            </td>
          </tr>
          <tr>
            <th class="table-light align-middle">発注方法</th>
            <td>
              <%= form.select :order_method, Customer.order_methods.keys.map { |k| [I18n.t("enums.customer.order_method.#{k}"), k] }, { include_blank: "選択してください" }, { class: "form-select" } %>
            </td>
          </tr>
          <tr>
            <th class="table-light align-middle">ケース割れ出荷</th>
            <td>
              <%= form.select :case_break_shipping_allowed, [
                ['可', true],
                ['否', false]
              ], { include_blank: "選択してください" }, { class: "form-select" } %>
            </td>
          </tr>
          <tr>
            <th class="table-light align-middle">ケース割れ送料</th>
            <td>
              <div class="input-group">
                <%= form.number_field :case_break_shipping_fee, class: "form-control" %>
                <span class="input-group-text">円</span>
              </div>
            </td>
          </tr>
          <tr>
            <th class="table-light align-middle">納品書</th>
            <td>
              <%= form.select :delivery_note_type, Customer.delivery_note_types.keys.map { |k| [I18n.t("enums.customer.delivery_note_type.#{k}"), k] }, { include_blank: "選択してください" }, { class: "form-select" } %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        📝 備考
      </div>
      <div class="card-body">
        <%= form.text_area :notes, rows: 5, class: "form-control", placeholder: "備考を入力してください" %>
      </div>
    </div>

    <div class="mt-3 d-flex gap-2">
      <%= form.submit "登録", class: "btn btn-primary" %>
      <%= link_to "戻る", :back, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>