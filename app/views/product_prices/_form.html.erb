<div class="mt-4">
  <%= form_with(model: [customer, product_price]) do |form| %>
    <% if product_price.errors.any? %>
      <div class="alert alert-danger">
        <h5><%= pluralize(product_price.errors.count, "個") %>のエラーがあります</h5>
        <ul class="mb-0">
          <% product_price.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="table-responsive">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <th class="table-light align-middle" style="width: 200px;">商品</th>
            <td>
              <%= form.collection_select :product_id, Product.all, :id, :product_name, { prompt: "商品を選択してください" }, { class: "form-select" } %>
            </td>
          </tr>
          <tr>
            <th class="table-light align-middle">販売単価（仕切）</th>
            <td>
              <div class="input-group">
                <span class="input-group-text">¥</span>
                <%= form.number_field :selling_price, step: 1, class: "form-control" %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        📝 備考
      </div>
      <div class="card-body">
        <%= form.text_area :notes, rows: 3, class: "form-control", placeholder: "備考を入力してください" %>
      </div>
    </div>

    <div class="mt-3 d-flex gap-2">
      <%= form.submit "登録", class: "btn btn-primary" %>
      <%= link_to "戻る", customer_product_prices_path(customer), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>