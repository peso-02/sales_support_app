<div class="mt-4">
  <%= form_with(model: [supplier, supplier_contact]) do |form| %>
    <% if supplier_contact.errors.any? %>
      <div class="alert alert-danger">
        <h5><%= pluralize(supplier_contact.errors.count, "個") %>のエラーがあります</h5>
        <ul class="mb-0">
          <% supplier_contact.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="table-responsive">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <th class="table-light align-middle" style="width: 200px;">担当者名</th>
            <td><%= form.text_field :contact_name, class: "form-control" %></td>
          </tr>
          <tr>
            <th class="table-light align-middle">メールアドレス</th>
            <td><%= form.email_field :email, class: "form-control" %></td>
          </tr>
          <tr>
            <th class="table-light align-middle">電話番号</th>
            <td><%= form.text_field :phone, class: "form-control" %></td>
          </tr>
          <tr>
            <th class="table-light align-middle">FAX番号</th>
            <td><%= form.text_field :fax, class: "form-control" %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        📝 備考
      </div>
      <div class="card-body">
        <%= form.text_area :notes, rows: 3, class: "form-control", placeholder: "備考を入力してください" %>
      </div>
    </div>

    <div class="mt-3 d-flex gap-2">
      <%= form.submit "登録", class: "btn btn-primary" %>
      <%= link_to "戻る", supplier_path(supplier), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>