<div class="mt-4">
  
  <div class="alert alert-info">
    <strong>ようこそ、<%= current_user.email %> さん</strong><br>
    役割: <%= current_user.role_i18n %>
  </div>

  <div class="row g-4">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">📋 得意先管理</h5>
          <p class="card-text">得意先情報の登録・編集・閲覧</p>
          <%= link_to "得意先一覧", customers_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">🏭 仕入先管理</h5>
          <p class="card-text">仕入先情報の登録・編集・閲覧</p>
          <%= link_to "仕入先一覧", suppliers_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">📦 商品管理</h5>
          <p class="card-text">商品情報・単価の登録・編集・閲覧</p>
          <%= link_to "商品一覧", products_path, class: "btn btn-primary" %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h5 class="card-title">📚 マニュアル管理</h5>
          <p class="card-text">得意先ごとのマニュアル管理</p>
          <%= link_to "マニュアル一覧", "#", class: "btn btn-secondary disabled" %>
          <small class="text-muted d-block mt-2">※後ほど実装予定</small>
        </div>
      </div>
    </div>
  </div>
</div>