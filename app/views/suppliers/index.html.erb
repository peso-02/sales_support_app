<div class="mt-4">
  <h2>仕入先一覧</h2>

  <div class="d-flex justify-content-between align-items-center my-3">
    <div>
      <%= link_to "新規登録", new_supplier_path, class: "btn btn-primary" %>
      <%= link_to "CSV出力", suppliers_path(format: :csv), class: "btn btn-success" %>
    </div>
    
    <div>
      <%= form_with url: import_suppliers_path, multipart: true, class: "d-flex" do |f| %>
        <%= f.file_field :file, accept: ".csv", class: "form-control me-2" %>
        <%= f.submit "CSVインポート", class: "btn btn-info" %>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>仕入先コード</th>
          <th>仕入先名</th>
          <th>支払条件</th>
          <th>ケース割れ発注</th>
          <th>ケース割れ送料</th>
          <th>担当者</th>
        </tr>
      </thead>
      <tbody>
        <% @suppliers.each do |supplier| %>
          <tr>
            <td><%= supplier.supplier_code %></td>
            <td><%= link_to supplier.supplier_name, supplier, class: "text-decoration-none" %></td>
            <td><%= supplier.payment_terms_display %></td>
            <td><%= supplier.case_break_order_allowed ? "可" : "否" %></td>
            <td><%= supplier.case_break_order_allowed ? "#{supplier.case_break_order_fee}円" : "-" %></td>
            <td><%= supplier.supplier_contacts.count %>名</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>