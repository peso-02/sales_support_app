<div class="mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= @supplier.supplier_name %></h1>
    <div>
      <%= link_to "編集", edit_supplier_path(@supplier), class: "btn btn-outline-secondary me-2" %>
      <%= link_to "削除", @supplier, data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-outline-danger" %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-bordered">
      <tbody>
        <tr>
          <th class="table-light" style="width: 200px;">仕入先コード</th>
          <td><%= @supplier.supplier_code %></td>
        </tr>
        <tr>
          <th class="table-light">仕入先名</th>
          <td><%= @supplier.supplier_name %></td>
        </tr>
        <tr>
          <th class="table-light">支払条件</th>
          <td><%= @supplier.payment_terms_display %></td>
        </tr>
        <tr>
          <th class="table-light">ケース割れ発注</th>
          <td><%= @supplier.case_break_order_allowed ? "可" : "否" %></td>
        </tr>
        <tr>
          <th class="table-light">ケース割れ送料</th>
          <td><%= @supplier.case_break_order_allowed ? "#{@supplier.case_break_order_fee}円" : "-" %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="card mt-3">
    <div class="card-header">
      📝 備考
    </div>
    <div class="card-body">
      <% if @supplier.notes.present? %>
        <%= simple_format(@supplier.notes) %>
      <% else %>
        <p class="text-muted mb-0">備考なし</p>
      <% end %>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span>👥 担当者一覧</span>
      <%= link_to "担当者を追加", new_supplier_supplier_contact_path(@supplier), class: "btn btn-sm btn-primary" %>
    </div>
    <div class="card-body">
      <% if @supplier.supplier_contacts.any? %>
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
              <tr>
                <th>担当者名</th>
                <th>メール</th>
                <th>電話番号</th>
                <th>FAX</th>
                <th>備考</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              <% @supplier.supplier_contacts.each do |contact| %>
                <tr>
                  <td><%= contact.contact_name %></td>
                  <td><%= contact.email %></td>
                  <td><%= contact.phone %></td>
                  <td><%= contact.fax %></td>
                  <td><%= contact.notes %></td>
                  <td>
                    <div class="d-flex gap-1">
                      <%= link_to "編集", edit_supplier_supplier_contact_path(@supplier, contact), class: "btn btn-sm btn-outline-secondary" %>
                      <%= button_to "削除", supplier_supplier_contact_path(@supplier, contact), method: :delete, data: { turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-outline-danger", form: { style: "display: inline-block;" } %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-muted mb-0">担当者が登録されていません</p>
      <% end %>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to "一覧に戻る", suppliers_path, class: "btn btn-secondary" %>
  </div>
</div>