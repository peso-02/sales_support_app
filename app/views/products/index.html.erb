<div class="mt-4">
  <h1>商品一覧</h1>

  <div class="d-flex justify-content-between align-items-center my-3">
    <div>
      <%= link_to "新規登録", new_product_path, class: "btn btn-primary" %>
      <%= link_to "CSV出力", products_path(format: :csv), class: "btn btn-success" %>
    </div>
    
    <div>
      <%= form_with url: import_products_path, multipart: true, class: "d-flex" do |f| %>
        <%= f.file_field :file, accept: ".csv", class: "form-control me-2" %>
        <%= f.submit "CSVインポート", class: "btn btn-info" %>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th>商品コード</th>
          <th>商品名</th>
          <th>入数</th>
          <th>A単価</th>
          <th>B単価</th>
          <th>C単価</th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= product.product_code %></td>
            <td><%= link_to product.product_name, product, class: "text-decoration-none" %></td>
            <td><%= product.case_quantity %></td>
            <td><%= number_to_currency(product.standard_price_a, unit: "¥", precision: 0) if product.standard_price_a %></td>
            <td><%= number_to_currency(product.standard_price_b, unit: "¥", precision: 0) if product.standard_price_b %></td>
            <td><%= number_to_currency(product.standard_price_c, unit: "¥", precision: 0) if product.standard_price_c %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>