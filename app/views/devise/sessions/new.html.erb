<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light">
  <div class="card border p-4" style="width: 100%; max-width: 400px;">
    <div class="text-center mb-4">
      <h1 class="fs-4 fw-medium mb-1">Sales Support</h1>
      <p class="text-muted small mb-0">アカウントにログイン</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label :email, "メールアドレス", class: "form-label text-muted small" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "form-control", placeholder: "email@example.com" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "パスワード", class: "form-label text-muted small" %>
        <%= f.password_field :password, autocomplete: "current-password",
            class: "form-control", placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="d-flex align-items-center gap-2 mb-4">
          <%= f.check_box :remember_me, class: "form-check-input mt-0" %>
          <%= f.label :remember_me, "ログイン状態を保持する", class: "form-check-label text-muted small" %>
        </div>
      <% end %>

      <%= f.submit "ログイン", class: "btn btn-outline-secondary w-100" %>
    <% end %>

    <div class="text-center mt-3">
      <%= link_to "パスワードをお忘れですか？", new_password_path(resource_name),
          class: "text-muted small text-decoration-none" %>
    </div>
    <div class="text-center mt-2">
      <%= link_to "アカウントを作成する", new_registration_path(resource_name),
          class: "text-muted small text-decoration-none" %>
    </div>
  </div>
</div>