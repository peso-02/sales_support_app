<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fs-4 fw-medium mb-0">ユーザー管理</h1>
    <%= link_to "ユーザーを追加", new_user_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <div class="table-responsive">
    <table class="table table-bordered">
      <thead class="table-light">
        <tr>
          <th>メールアドレス</th>
          <th>ロール</th>
          <th>作成日</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.email %></td>
            <td><%= user.role_i18n %></td>
            <td><%= user.created_at.strftime("%Y/%m/%d") %></td>
            <td class="text-end">
              <%= link_to "編集", edit_user_path(user), class: "btn btn-outline-secondary btn-sm me-1" %>
              <% if user != current_user %>
                <%= link_to "削除", user_path(user), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-outline-danger btn-sm" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>